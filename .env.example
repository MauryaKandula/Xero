# GEMINI_API_KEY: Required for server-side Gemini chat & Gemini Live voice sessions.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional signing secret override for single-use Live WebSocket session tokens (auto-generated if omitted)
# LIVE_TOKEN_SECRET=""

# Optional server port (AI Studio & preview iframe require port 3000)
PORT=3000
